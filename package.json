{
  "name": "music-player-serverless",
  "version": "5.1.0-serverless",
  "description": "Music Player - Serverless Web Edition with built-in API & UNM unlock",
  "author": "Alger <algerkc@qq.com>",
  "homepage": "https://github.com/zilanLY/music",
  "scripts": {
    "prepare:local": "husky",
    "format": "prettier --write ./src",
    "lint": "eslint ./src --fix && npm run lint:i18n",
    "lint:i18n": "bun scripts/check_i18n.ts",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:web",
    "dev": "vite dev",
    "dev:web": "vite dev",
    "dev:full": "node server.js & vite dev",
    "build": "vite build",
    "build:web": "vite build",
    "server": "node server.js",
    "postinstall": "echo 'Serverless mode — skipping electron-builder'"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,vue,js,css,scss,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@unblockneteasemusic/server": "^0.27.10",
    "cookie": "^1.1.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "express": "^4.22.1",
    "express-fileupload": "^1.5.1",
    "file-type": "^21.1.1",
    "form-data": "^4.0.5",
    "hono": "^4.4.0",
    "jsencrypt": "^3.5.4",
    "music-metadata": "^11.10.3",
    "netease-cloud-music-api-alger": "^4.30.0",
    "node-fetch": "^2.7.0",
    "node-forge": "^1.4.0",
    "pac-proxy-agent": "^9.0.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "safe-decode-uri-component": "^1.0.1",
    "tunnel": "^0.0.6",
    "vue-i18n": "^11.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.2",
    "@rushstack/eslint-patch": "^1.15.0",
    "@types/howler": "^2.2.12",
    "@types/node": "20.17.0",
    "@types/node-fetch": "^2.6.13",
    "@types/tinycolor2": "^1.4.6",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.25",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/runtime-core": "^3.5.39",
    "@vueuse/core": "^11.3.0",
    "animate.css": "^4.1.1",
    "autoprefixer": "^10.4.22",
    "axios": "^1.17.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^10.6.2",
    "eslint-plugin-vue-scoped-css": "^2.12.0",
    "globals": "^16.5.0",
    "howler": "^2.2.4",
    "lint-staged": "^15.5.2",
    "lodash": "^4.17.21",
    "marked": "^15.0.12",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "pinyin-match": "^1.2.10",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "remixicon": "^4.7.0",
    "sass": "^1.96.0",
    "tailwindcss": "^3.4.19",
    "tinycolor2": "^1.6.0",
    "tunajs": "^1.0.15",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.4.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "7.7.2",
    "vue": "^3.5.16",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
